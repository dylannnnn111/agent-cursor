{
  "name": "agent-cursor",
  "displayName": "Agent Cursor",
  "description": "See where your coding agents are working, live: Claude Code, Codex, Gemini CLI, Qwen Code, Cursor, Copilot CLI, OpenCode, Kimi Code and Windsurf, each with its own look.",
  "version": "0.2.0",
  "publisher": "dylanlewis",
  "license": "MIT",
  "author": {
    "name": "Dylan Lewis",
    "url": "https://dylanlewis.au"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dylannnnn111/agent-cursor"
  },
  "homepage": "https://github.com/dylannnnn111/agent-cursor#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1726",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "claude code",
    "codex",
    "gemini cli",
    "qwen code",
    "cursor",
    "copilot",
    "opencode",
    "kimi",
    "windsurf",
    "coding agent",
    "ai agent",
    "visualise"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCursor",
          "title": "Agent Cursor",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentCursor": [
        {
          "type": "webview",
          "id": "agentCursor.panel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "agentCursor.connect",
        "title": "Connect Coding Agents",
        "category": "Agent Cursor"
      },
      {
        "command": "agentCursor.disconnect",
        "title": "Disconnect Coding Agents",
        "category": "Agent Cursor"
      },
      {
        "command": "agentCursor.toggleFollow",
        "title": "Toggle Follow the Agent",
        "category": "Agent Cursor"
      },
      {
        "command": "agentCursor.showPanel",
        "title": "Show the Agent Panel",
        "category": "Agent Cursor"
      },
      {
        "command": "agentCursor.demo",
        "title": "Run the Demo",
        "category": "Agent Cursor"
      }
    ],
    "configuration": {
      "title": "Agent Cursor",
      "properties": {
        "agentCursor.follow": {
          "type": "boolean",
          "default": false,
          "description": "Open each file the agent moves to and scroll to where it's working. Pauses while you're typing."
        }
      }
    },
    "colors": [
      {
        "id": "agentCursor.claude",
        "description": "claude agent",
        "defaults": {
          "dark": "#E0533F",
          "light": "#C8432F",
          "highContrast": "#FF6B57"
        }
      },
      {
        "id": "agentCursor.codex",
        "description": "codex agent",
        "defaults": {
          "dark": "#22B07D",
          "light": "#178258",
          "highContrast": "#5FD3A4"
        }
      },
      {
        "id": "agentCursor.gemini",
        "description": "gemini agent",
        "defaults": {
          "dark": "#4C7BD9",
          "light": "#2D58B5",
          "highContrast": "#86A6EE"
        }
      },
      {
        "id": "agentCursor.qwen",
        "description": "qwen agent",
        "defaults": {
          "dark": "#8B5CF6",
          "light": "#6A37DD",
          "highContrast": "#B094FA"
        }
      },
      {
        "id": "agentCursor.kimi",
        "description": "kimi agent",
        "defaults": {
          "dark": "#14B8A6",
          "light": "#0D8A7C",
          "highContrast": "#5EE0CF"
        }
      },
      {
        "id": "agentCursor.cursor",
        "description": "cursor agent",
        "defaults": {
          "dark": "#C3CCD9",
          "light": "#5B6678",
          "highContrast": "#E6EBF2"
        }
      },
      {
        "id": "agentCursor.copilot",
        "description": "copilot agent",
        "defaults": {
          "dark": "#D9971E",
          "light": "#A8730F",
          "highContrast": "#F1BC54"
        }
      },
      {
        "id": "agentCursor.opencode",
        "description": "opencode agent",
        "defaults": {
          "dark": "#E0559B",
          "light": "#B33A78",
          "highContrast": "#F08CC0"
        }
      },
      {
        "id": "agentCursor.windsurf",
        "description": "windsurf agent",
        "defaults": {
          "dark": "#38BDF8",
          "light": "#0E7DB0",
          "highContrast": "#7DD3FC"
        }
      },
      {
        "id": "agentCursor.cline",
        "description": "cline agent",
        "defaults": {
          "dark": "#E8C33A",
          "light": "#9A7A10",
          "highContrast": "#F5DA77"
        }
      },
      {
        "id": "agentCursor.agent",
        "description": "agent agent",
        "defaults": {
          "dark": "#9AA7BD",
          "light": "#6F7C93",
          "highContrast": "#C3CCDA"
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "npm run build && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.84.0",
    "typescript": "^5"
  }
}
